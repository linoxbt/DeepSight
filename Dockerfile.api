FROM node:22-bookworm-slim AS node
FROM postgres:18.6-bookworm AS pgtools
FROM python:3.12-slim-bookworm
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=pgtools /etc/apt/sources.list.d/pgdg.list /etc/apt/sources.list.d/pgdg.list
COPY --from=pgtools /usr/local/share/keyrings/postgres.gpg.asc /usr/local/share/keyrings/postgres.gpg.asc
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client-18 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock
COPY api/package.json api/package-lock.json ./api/
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN node /usr/local/lib/node_modules/npm/bin/npm-cli.js ci --prefix api --omit=dev --ignore-scripts --no-audit --no-fund
COPY api ./api
COPY scripts ./scripts
COPY alembic.ini ./alembic.ini
COPY migrations ./migrations
RUN useradd --uid 10001 --create-home researcher && mkdir -p /app/data && chown -R researcher:researcher /app/data
USER researcher
ENV PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
